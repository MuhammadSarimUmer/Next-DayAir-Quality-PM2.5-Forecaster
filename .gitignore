# Secrets and local configuration
.env
.env.*
!.env.example

# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
sem-env/

# Jupyter temporary files and checkpoints
.ipynb_checkpoints/

# Generated datasets and collection artifacts
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated reports, plots, and experiment outputs
reports/*
!reports/.gitkeep
!reports/figures/.gitkeep

# Trained models and serialized pipelines
*.joblib
*.pkl
*.pickle
models/

# Local logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo

# Operating-system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
